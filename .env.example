# Application Environment Variables
PROJECT_NAME="AI-Powered Personal Student Academic & Life Assistant"
SECRET_KEY="replace-with-a-secure-random-jwt-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default; can be changed to postgresql://user:pass@localhost:5432/academic_db)
DATABASE_URL="sqlite:///./academic_assistant.db"

# Google Gemini LLM API Key (Optional: Leave blank to use grounded local demo mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# Frontend Port: 5173
# Backend Port: 8000
VITE_API_URL="http://localhost:8000/api"
